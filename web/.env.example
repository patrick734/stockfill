# Robinhood Chain RPC for the browser. Use a key restricted to your domain: every NEXT_PUBLIC_
# value is visible to visitors. Leave blank for the public RPC.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Contract addresses come from the deployment (web/src/generated/router.json and web/src/generated/vaults),
# written by ./launch.sh and ./set-token.sh. Nothing to set here for production.

# Optional: your site's domain, and your X profile URL (linked in the footer).
NEXT_PUBLIC_DOMAIN=
NEXT_PUBLIC_X_URL=

# Optional: full site URL for link previews (defaults to the Vercel production URL).
NEXT_PUBLIC_SITE_URL=
